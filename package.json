{
  "name": "mcp-server-kubernetes",
  "version": "4.1.7",
  "description": "MCP server for interacting with Kubernetes clusters via kubectl",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/phuquocchamp/kubernetes-mcp"
  },
  "bin": {
    "mcp-server-kubernetes": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx chmod +x dist/*.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --project unit",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:all": "vitest run",
    "lint": "biome check src",
    "format": "biome format --write src",
    "version:update": "node scripts/update-version.js"
  },
  "keywords": [
    "mcp",
    "kubernetes",
    "claude",
    "anthropic",
    "kubectl"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@kubernetes/client-node": "1.3.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.77.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.219.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "express": "4.22.2",
    "js-yaml": "4.3.2",
    "yaml": "2.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/express": "5.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.9.3",
    "shx": "0.3.4",
    "typescript": "5.6.2",
    "vitest": "3.2.6"
  }
}
